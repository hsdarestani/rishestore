generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum ProductKind {
  PRODUCT
  PACK
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id           String    @id @default(cuid())
  name         String
  phone        String    @unique
  email        String?   @unique
  passwordHash String
  role         UserRole  @default(CUSTOMER)
  permissions  Json?
  orders       Order[]
  addresses    Address[]
  auditLogs    AuditLog[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  title      String   @default("آدرس من")
  province   String
  city       String
  address    String
  postalCode String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Category {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  description    String?
  image          String?
  sort           Int             @default(0)
  products       Product[]
  analyticsGoals AnalyticsGoal[]
}

model Product {
  id               String              @id @default(cuid())
  legacyProductId  Int?                @unique
  slug             String              @unique
  name             String
  kind             ProductKind         @default(PRODUCT)
  shortDescription String
  description      String              @db.Text
  price            Int                 @default(0)
  compareAt        Int?
  weightGrams      Int?
  stock            Int                 @default(0)
  stockStatus      String?
  allowBackorder   Boolean             @default(false)
  sourceUrl        String?
  legacyContent    Json?
  origin           String?
  usage            String?
  quality          String?
  guarantee        String?
  image            String?
  gallery          Json?
  featured         Boolean             @default(false)
  active           Boolean             @default(true)
  categoryId       String?
  category         Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  seoTitle         String?
  seoDescription   String?
  orderItems       OrderItem[]
  inventoryBatches InventoryBatch[]
  inventoryMoves   InventoryMovement[]
  purchaseItems    PurchaseOrderItem[]
  bomOutputs       Bom[]               @relation("BomOutput")
  bomMaterials     BomItem[]           @relation("BomMaterial")
  consignmentItems ConsignmentItem[]
  manualSaleItems  ManualSaleItem[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model Page {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  kicker         String?
  excerpt        String?
  content        String   @db.Text
  seoTitle       String?
  seoDescription String?
  updatedAt      DateTime @updatedAt
}

model Post {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  excerpt          String
  content          String   @db.Text
  image             String?
  keywords          String?
  published         Boolean  @default(true)
  healthDisclaimer Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Faq {
  id       String @id @default(cuid())
  question String @unique
  answer   String @db.Text
  sort     Int    @default(0)
}

model Review {
  id        String   @id @default(cuid())
  name      String
  text      String   @db.Text
  rating    Int      @default(5)
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Order {
  id              String        @id @default(cuid())
  code            String        @unique
  userId          String?
  customerId      String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName    String
  phone           String
  email           String?
  province        String
  city            String
  address         String
  postalCode      String?
  notes           String?
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  subtotal        Int
  shippingCost    Int
  total           Int
  paymentProvider String?
  transactionId   String?       @unique
  paymentRef      String?
  items           OrderItem[]
  shipments       Shipment[]
  taxInvoices     TaxInvoice[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  productSlug String
  unitPrice   Int
  quantity    Int
  total       Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model Warehouse {
  id             String              @id @default(cuid())
  code           String              @unique
  name           String
  address        String?
  active         Boolean             @default(true)
  batches        InventoryBatch[]
  movements      InventoryMovement[]
  productionRuns ProductionRun[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model InventoryBatch {
  id          String    @id @default(cuid())
  warehouseId String
  productId   String
  batchCode   String
  quantity    Int       @default(0)
  reserved    Int       @default(0)
  unitCost    Int       @default(0)
  receivedAt  DateTime  @default(now())
  expiresAt   DateTime?
  notes       String?
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, productId, batchCode])
  @@index([productId, warehouseId])
}

model InventoryMovement {
  id            String    @id @default(cuid())
  warehouseId   String
  productId     String
  type          String
  quantity      Int
  unitCost      Int?
  referenceType String?
  referenceId   String?
  note          String?
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product       Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now())

  @@index([productId, warehouseId, createdAt])
}

model Supplier {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  phone          String?
  email          String?
  taxId          String?
  address        String?
  notes          String?
  active         Boolean         @default(true)
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  code       String              @unique
  supplierId String
  status     String              @default("draft")
  subtotal   Int                 @default(0)
  landedCost Int                 @default(0)
  total      Int                 @default(0)
  notes      String?
  supplier   Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items      PurchaseOrderItem[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  receivedQty     Int           @default(0)
  unitPrice       Int
  total           Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Bom {
  id             String          @id @default(cuid())
  code           String          @unique
  productId      String
  version        Int             @default(1)
  outputQuantity Int             @default(1)
  active         Boolean         @default(false)
  notes          String?
  product        Product         @relation("BomOutput", fields: [productId], references: [id], onDelete: Restrict)
  items          BomItem[]
  productionRuns ProductionRun[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([productId, version])
}

model BomItem {
  id                String  @id @default(cuid())
  bomId             String
  materialProductId String
  quantity          Int
  wasteBps          Int     @default(0)
  bom               Bom     @relation(fields: [bomId], references: [id], onDelete: Cascade)
  materialProduct   Product @relation("BomMaterial", fields: [materialProductId], references: [id], onDelete: Restrict)
}

model ProductionRun {
  id           String    @id @default(cuid())
  code         String    @unique
  bomId        String
  warehouseId  String
  quantity     Int
  status       String    @default("planned")
  materialCost Int       @default(0)
  laborCost    Int       @default(0)
  wasteCost    Int       @default(0)
  totalCost    Int       @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  notes        String?
  bom          Bom       @relation(fields: [bomId], references: [id], onDelete: Restrict)
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AccountingAccount {
  id           String              @id @default(cuid())
  code         String              @unique
  name         String
  level        Int                 @default(1)
  type         String
  parentId     String?
  active       Boolean             @default(true)
  parent       AccountingAccount?  @relation("AccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     AccountingAccount[] @relation("AccountTree")
  voucherLines VoucherLine[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model Voucher {
  id          String        @id @default(cuid())
  code        String        @unique
  date        DateTime      @default(now())
  status      String        @default("draft")
  description String?
  sourceType  String?
  sourceId    String?
  totalDebit  Int           @default(0)
  totalCredit Int           @default(0)
  lines       VoucherLine[]
  createdAt   DateTime      @default(now())
  postedAt    DateTime?
}

model VoucherLine {
  id          String            @id @default(cuid())
  voucherId   String
  accountId   String
  debit       Int               @default(0)
  credit      Int               @default(0)
  description String?
  voucher     Voucher           @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  account     AccountingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
}

model TreasuryAccount {
  id           String                @id @default(cuid())
  code         String                @unique
  name         String
  type         String
  iban         String?
  cardNumber   String?
  accountNo    String?
  active       Boolean               @default(true)
  transactions TreasuryTransaction[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model TreasuryTransaction {
  id          String          @id @default(cuid())
  accountId   String
  externalId  String?         @unique
  direction   String
  amount      Int
  description String?
  sourceType  String?
  sourceId    String?
  status      String          @default("posted")
  account     TreasuryAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdAt   DateTime        @default(now())
}

model ManualSale {
  id           String           @id @default(cuid())
  code         String           @unique
  channel      String
  eventName    String?
  customerName String?
  phone        String?
  seller       String?
  status       String           @default("completed")
  paymentType  String?
  total        Int
  items        ManualSaleItem[]
  createdAt    DateTime         @default(now())
}

model ManualSaleItem {
  id        String     @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Int
  total     Int
  sale      ManualSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model B2BAccount {
  id               String        @id @default(cuid())
  code             String        @unique
  name             String
  phone            String?
  email            String?
  creditLimit      Int           @default(0)
  balance          Int           @default(0)
  commissionBps    Int           @default(0)
  status           String        @default("active")
  notes            String?
  consignments     Consignment[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Consignment {
  id           String            @id @default(cuid())
  code         String            @unique
  b2bAccountId String
  status       String            @default("open")
  total        Int               @default(0)
  notes        String?
  b2bAccount   B2BAccount        @relation(fields: [b2bAccountId], references: [id], onDelete: Restrict)
  items        ConsignmentItem[]
  createdAt    DateTime          @default(now())
  settledAt    DateTime?
}

model ConsignmentItem {
  id            String      @id @default(cuid())
  consignmentId String
  productId     String
  quantity      Int
  soldQty       Int         @default(0)
  unitPrice     Int
  consignment   Consignment @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Carrier {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  active    Boolean    @default(true)
  config    Json?
  shipments Shipment[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Shipment {
  id            String   @id @default(cuid())
  code          String   @unique
  orderId       String?
  carrierId     String?
  status        String   @default("draft")
  trackingCode  String?
  recipientName String
  phone         String
  address       String
  cost          Int      @default(0)
  actualCost    Int?
  notes         String?
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  carrier       Carrier? @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  shippedAt     DateTime?
  deliveredAt   DateTime?
}

model TaxProfile {
  id        String       @id @default(cuid())
  name      String
  taxId     String
  memoryId  String?
  enabled   Boolean      @default(false)
  invoices  TaxInvoice[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model TaxInvoice {
  id            String      @id @default(cuid())
  profileId     String
  orderId       String?
  number        String      @unique
  status        String      @default("draft")
  total         Int
  trackingCode  String?
  referenceId   String?
  payloadHash   String?
  profile       TaxProfile  @relation(fields: [profileId], references: [id], onDelete: Restrict)
  order         Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  submittedAt   DateTime?
}

model AnalyticsGoal {
  id           String    @id @default(cuid())
  name         String
  metric       String
  target       Int
  periodStart  DateTime
  periodEnd    DateTime
  salesChannel String?
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model OperationJob {
  id             String   @id @default(cuid())
  type           String
  aggregateId    String?
  idempotencyKey String   @unique
  status         String   @default("pending")
  attempts       Int      @default(0)
  maxAttempts    Int      @default(5)
  nextRunAt      DateTime?
  lastError      String?
  payload        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SystemIncident {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  severity    String   @default("warning")
  status      String   @default("open")
  title       String
  message     String   @db.Text
  occurrences Int      @default(1)
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  action        String
  entityType    String
  entityId      String?
  correlationId String
  metadata      Json?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}


model Customer {
  id               String   @id @default(cuid())
  customerKey      String   @unique
  mobileNormalized String?  @unique
  name             String?
  email            String?
  status           String   @default("active")
  province         String?
  city             String?
  sourceCode       String?
  firstPurchase    DateTime?
  lastPurchase     DateTime?
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([email])
  @@index([status])
}

model CustomerChannel {
  id                 String   @id @default(cuid())
  customerId         String
  channel            String
  externalCustomerId String
  createdAt          DateTime @default(now())

  @@unique([channel, externalCustomerId])
  @@index([customerId])
}

model ChannelPrice {
  id        String   @id @default(cuid())
  productId String
  channel   String
  price     Int
  active    Boolean  @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, channel, active])
}

model Promotion {
  id          String   @id @default(cuid())
  promotionKey String  @unique
  code        String?  @unique
  name        String
  channel     String?
  type        String
  value       Int
  minSubtotal Int       @default(0)
  maxUses     Int?
  perCustomer Int?
  active      Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PromotionRedemption {
  id          String   @id @default(cuid())
  promotionId String
  orderId     String
  customerId  String?
  amount      Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([promotionId, orderId])
  @@index([promotionId, customerId])
}

model LoyaltyEntry {
  id         String   @id @default(cuid())
  entryKey   String   @unique
  customerId String
  orderId    String?
  points     Int
  reason     String?
  expiresAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

model OrderHistory {
  id        String   @id @default(cuid())
  orderId   String
  fromState String?
  toState   String
  reason    String?
  actorId   String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model InventoryReservation {
  id          String   @id @default(cuid())
  reservationKey String @unique
  orderId     String?
  warehouseId String
  productId   String
  batchId     String?
  quantity    Int
  status      String   @default("active")
  expiresAt   DateTime?
  committedAt DateTime?
  releasedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([orderId, status])
  @@index([warehouseId, productId, status])
}

model EventSaleEvent {
  id          String   @id @default(cuid())
  publicId    String   @unique
  name        String
  status      String   @default("draft")
  warehouseId String?
  startsAt    DateTime?
  endsAt      DateTime?
  location    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EventSeller {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  displayName String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}

model EventDeviceSession {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  eventId     String
  sellerUserId String?
  deviceName  String?
  expiresAt   DateTime
  revokedAt   DateTime?
  lastSeenAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([eventId, expiresAt])
}

model EventSale {
  id            String   @id @default(cuid())
  publicId      String   @unique
  clientUuid    String   @unique
  eventId       String
  sellerUserId  String?
  customerId    String?
  customerName  String?
  mobile        String?
  status        String   @default("completed")
  paymentType   String?
  subtotal      Int
  discount      Int      @default(0)
  total         Int
  occurredAt    DateTime
  syncedAt      DateTime @default(now())
  metadata      Json?

  @@index([eventId, status, occurredAt])
}

model EventSaleLine {
  id          String @id @default(cuid())
  eventSaleId String
  productId   String
  quantity    Int
  unitPrice   Int
  total       Int

  @@unique([eventSaleId, productId])
}

model TreasuryProvider {
  id                String   @id @default(cuid())
  publicId          String   @unique
  code              String   @unique
  name              String
  adapter           String
  treasuryAccountId String?
  active            Boolean  @default(true)
  config             Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model PaymentLink {
  id                String   @id @default(cuid())
  publicId          String   @unique
  idempotencyKey    String   @unique
  providerId        String
  treasuryAccountId String?
  orderId           String?
  customerId        String?
  amount            Int
  status            String   @default("pending")
  providerLinkId    String?
  url               String?
  expiresAt         DateTime?
  correlationId     String?
  createdAt         DateTime @default(now())
  paidAt            DateTime?

  @@index([orderId])
  @@index([status, expiresAt])
}

model TreasuryMatch {
  id           String   @id @default(cuid())
  publicId     String   @unique
  transactionId String
  matchType    String
  entityId     String
  amount       Int
  createdAt    DateTime @default(now())

  @@unique([transactionId, matchType, entityId])
}

model TreasurySettlement {
  id                    String   @id @default(cuid())
  publicId              String   @unique
  providerId            String?
  treasuryAccountId     String
  externalSettlementId  String?
  amount                Int
  fee                   Int      @default(0)
  settledAt             DateTime
  metadata              Json?
  createdAt             DateTime @default(now())

  @@unique([providerId, externalSettlementId])
}

model PurchaseReceipt {
  id              String   @id @default(cuid())
  publicId        String   @unique
  code            String   @unique
  purchaseOrderId String
  supplierId      String
  warehouseId     String
  status          String   @default("posted")
  subtotal        Int
  landedCost      Int      @default(0)
  total           Int
  dueDate         DateTime?
  accountingStatus String  @default("pending")
  receivedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([purchaseOrderId])
  @@index([supplierId, dueDate])
}

model PurchaseReceiptLine {
  id                  String @id @default(cuid())
  purchaseReceiptId   String
  purchaseOrderItemId String
  productId           String
  inventoryBatchId    String?
  quantity            Int
  unitCost            Int
  total               Int

  @@unique([purchaseReceiptId, purchaseOrderItemId])
}

model LandedCost {
  id                String @id @default(cuid())
  purchaseReceiptId String
  costType          String
  amount            Int
  allocationMethod  String @default("value")
  note              String?

  @@index([purchaseReceiptId])
}

model SupplierLedgerEntry {
  id              String   @id @default(cuid())
  publicId        String   @unique
  supplierId      String
  purchaseOrderId String?
  receiptId       String?
  paymentId       String?
  entryType       String
  debit           Int      @default(0)
  credit          Int      @default(0)
  balance         Int
  dueDate         DateTime?
  createdAt       DateTime @default(now())

  @@index([supplierId, createdAt])
}

model PurchasePayment {
  id                    String   @id @default(cuid())
  publicId              String   @unique
  purchaseOrderId       String?
  supplierId            String
  treasuryTransactionId String?  @unique
  amount                Int
  paidAt                DateTime @default(now())
  note                  String?
}

model B2BDispatch {
  id                   String   @id @default(cuid())
  publicId             String   @unique
  code                 String   @unique
  accountId            String
  sourceWarehouseId    String
  destinationWarehouseId String?
  status               String   @default("posted")
  idempotencyKey       String   @unique
  dispatchedAt         DateTime @default(now())
  correlationId        String?
  createdAt            DateTime @default(now())

  @@index([accountId, status])
}

model B2BDispatchLine {
  id           String @id @default(cuid())
  dispatchId   String
  productId    String
  quantity     Int
  unitPrice    Int
  transferGroupId String @unique

  @@unique([dispatchId, productId])
}

model B2BReturn {
  id             String   @id @default(cuid())
  publicId       String   @unique
  code           String   @unique
  accountId      String
  dispatchId     String?
  idempotencyKey String   @unique
  returnedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([accountId, returnedAt])
}

model B2BReturnLine {
  id             String @id @default(cuid())
  returnId       String
  dispatchLineId String?
  productId      String
  quantity       Int
  transferGroupId String @unique
}

model B2BSalesReport {
  id                String   @id @default(cuid())
  publicId          String   @unique
  code              String   @unique
  accountId         String
  externalReference String?
  status            String   @default("posted")
  subtotal          Int
  commission        Int      @default(0)
  receivable        Int
  idempotencyKey    String   @unique
  reportedAt        DateTime @default(now())
  createdAt         DateTime @default(now())

  @@unique([accountId, externalReference])
}

model B2BSalesReportLine {
  id            String @id @default(cuid())
  salesReportId String
  productId     String
  quantity      Int
  unitPrice     Int
  total         Int

  @@unique([salesReportId, productId])
}

model B2BLedgerEntry {
  id           String   @id @default(cuid())
  publicId     String   @unique
  accountId    String
  reportId     String?
  settlementId String?
  entryType    String
  debit        Int      @default(0)
  credit       Int      @default(0)
  balance      Int
  dueDate      DateTime?
  createdAt    DateTime @default(now())

  @@index([accountId, createdAt])
}

model B2BSettlement {
  id                    String   @id @default(cuid())
  publicId              String   @unique
  accountId             String
  treasuryTransactionId String?  @unique
  amount                Int
  settledAt             DateTime @default(now())
  note                  String?
}

model ShipmentTrackingEvent {
  id              String   @id @default(cuid())
  shipmentId      String
  externalEventId String?
  status          String
  location        String?
  message         String?
  occurredAt      DateTime
  payload         Json?
  createdAt       DateTime @default(now())

  @@unique([shipmentId, externalEventId])
  @@index([shipmentId, occurredAt])
}

model ShipmentCost {
  id              String   @id @default(cuid())
  publicId        String   @unique
  shipmentId      String
  costType        String
  amount          Int
  externalCostId  String?
  invoiceReference String?
  incurredAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([shipmentId, incurredAt])
}

model LogisticsSettlement {
  id                    String   @id @default(cuid())
  publicId              String   @unique
  shipmentId            String
  treasuryTransactionId String?  @unique
  amount                Int
  settledAt             DateTime @default(now())
}

model TaxProductMapping {
  id           String   @id @default(cuid())
  profileId    String
  productId    String
  taxProductId String
  title        String?
  unitCode     String?
  vatRateBps   Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([profileId, productId])
  @@index([taxProductId])
}

model TaxInvoiceLine {
  id            String @id @default(cuid())
  taxInvoiceId  String
  productId     String?
  taxProductId  String?
  description   String
  quantity      Int
  unitPrice     Int
  discount      Int    @default(0)
  vat           Int    @default(0)
  total         Int

  @@index([taxInvoiceId])
}

model TaxSubmission {
  id            String   @id @default(cuid())
  publicId      String   @unique
  taxInvoiceId  String
  attemptNumber Int
  status        String
  referenceNumber String?
  requestHash   String?
  response      Json?
  createdAt     DateTime @default(now())

  @@unique([taxInvoiceId, attemptNumber])
}

model TaxEvent {
  id           String   @id @default(cuid())
  taxInvoiceId String
  eventType    String
  status       String?
  payloadHash  String?
  payload      Json?
  createdAt    DateTime @default(now())

  @@index([taxInvoiceId, createdAt])
}

model AnalyticsSource {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  channel   String?
  active    Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())
}

model AnalyticsCampaign {
  id          String   @id @default(cuid())
  campaignKey String   @unique
  name        String
  sourceId    String?
  channel     String?
  status      String   @default("active")
  startsAt    DateTime?
  endsAt      DateTime?
  metadata    Json?
  createdAt   DateTime @default(now())
}

model OrderAttribution {
  id                String   @id @default(cuid())
  orderId           String   @unique
  sourceId          String?
  campaignId        String?
  channel           String?
  salespersonUserId String?
  province          String?
  city              String?
  attributedAt      DateTime @default(now())
}

model PriceHistory {
  id            String   @id @default(cuid())
  priceKey      String   @unique
  productId     String
  channel       String
  price         Int
  cost          Int?
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime @default(now())

  @@unique([productId, channel, effectiveFrom])
  @@index([productId, channel, effectiveTo])
}

model AnalyticsEvent {
  id            String   @id @default(cuid())
  eventKey      String   @unique
  eventType     String
  orderId       String?
  customerId    String?
  productId     String?
  campaignId    String?
  salesChannel  String?
  sourceCode    String?
  province      String?
  city          String?
  amount        Int?
  quantity      Int?
  correlationId String?
  payload       Json?
  occurredAt    DateTime
  createdAt     DateTime @default(now())

  @@index([eventType, occurredAt])
  @@index([orderId, eventType, occurredAt])
}

model AnalyticsAlert {
  id         String   @id @default(cuid())
  alertKey   String   @unique
  fingerprint String  @unique
  ruleCode   String
  severity   String
  status     String   @default("open")
  entityType String?
  entityId   String?
  title      String
  message    String
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  resolvedAt DateTime?

  @@index([status, severity])
}

model ConfigSnapshot {
  id        String   @id @default(cuid())
  checksum  String   @unique
  payload   Json
  createdBy String?
  createdAt DateTime @default(now())
}

model BackupRecord {
  id          String   @id @default(cuid())
  filename    String   @unique
  checksum    String
  sizeBytes   Int
  status      String   @default("created")
  verifiedAt  DateTime?
  createdBy   String?
  createdAt   DateTime @default(now())
}

model ChatSession {
  id          String   @id @default(cuid())
  publicId    String   @unique
  userId      String?
  customerName String?
  phone       String?
  status      String   @default("open")
  lastReadAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, updatedAt])
}

model ChatMessage {
  id          String   @id @default(cuid())
  sessionId   String
  sender      String
  text        String   @db.Text
  externalId  String?  @unique
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([sessionId, createdAt])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}
