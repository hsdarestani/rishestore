generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum ProductKind {
  PRODUCT
  PACK
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id           String    @id @default(cuid())
  name         String
  phone        String    @unique
  email        String?   @unique
  passwordHash String
  role         UserRole  @default(CUSTOMER)
  orders       Order[]
  addresses    Address[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  title      String   @default("آدرس من")
  province   String
  city       String
  address    String
  postalCode String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  image       String?
  sort        Int       @default(0)
  products    Product[]
}

model Product {
  id               String      @id @default(cuid())
  slug             String      @unique
  name             String
  kind             ProductKind @default(PRODUCT)
  shortDescription String
  description      String      @db.Text
  price            Int         @default(0)
  compareAt        Int?
  weightGrams      Int?
  stock            Int         @default(0)
  origin           String?
  usage            String?
  quality          String?
  guarantee        String?
  image            String?
  gallery          Json?
  featured         Boolean     @default(false)
  active           Boolean     @default(true)
  categoryId       String?
  category         Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  seoTitle         String?
  seoDescription   String?
  orderItems       OrderItem[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Page {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  kicker         String?
  excerpt        String?
  content        String   @db.Text
  seoTitle       String?
  seoDescription String?
  updatedAt      DateTime @updatedAt
}

model Post {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  excerpt          String
  content          String   @db.Text
  image            String?
  keywords         String?
  published        Boolean  @default(true)
  healthDisclaimer Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Faq {
  id       String @id @default(cuid())
  question String @unique
  answer   String @db.Text
  sort     Int    @default(0)
}

model Review {
  id        String   @id @default(cuid())
  name      String
  text      String   @db.Text
  rating    Int      @default(5)
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Order {
  id              String        @id @default(cuid())
  code            String        @unique
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName    String
  phone           String
  email           String?
  province        String
  city            String
  address         String
  postalCode      String?
  notes           String?
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  subtotal        Int
  shippingCost    Int
  total           Int
  paymentProvider String?
  transactionId   String?       @unique
  paymentRef      String?
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  productSlug String
  unitPrice   Int
  quantity    Int
  total       Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}
