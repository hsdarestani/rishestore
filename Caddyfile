{
  debug
}

new.rishe.store {
  encode zstd gzip

  reverse_proxy {
    dynamic a app 3000 {
      refresh 2s
      resolvers 127.0.0.11
      versions ipv4
    }
  }

  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "SAMEORIGIN"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
}
